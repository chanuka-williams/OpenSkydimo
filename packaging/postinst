#!/bin/sh
set -e

if ! command -v systemctl >/dev/null 2>&1; then
    echo "Warning: systemctl not found; skipping service setup." >&2
    exit 0
fi

# Clean up the old per-user service from earlier versions, if present.
systemctl --global disable openskydimo.service >/dev/null 2>&1 || true
for dir in /run/user/*; do
    [ -d "$dir" ] || continue
    uid=$(basename "$dir")
    user=$(id -nu "$uid" 2>/dev/null) || continue
    runuser -u "$user" -- env XDG_RUNTIME_DIR="$dir" systemctl --user stop openskydimo.service >/dev/null 2>&1 || true
done

systemctl daemon-reload || true
if ! systemctl enable --now openskydimo.service; then
    echo "Warning: failed to enable/start openskydimo.service." >&2
fi

exit 0